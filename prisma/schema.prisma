generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  password         String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  profile          UserProfile?
  recipes          Recipe[]
  favorites        UserFavorite[]
  edamamMacroCache EdamamUserMacroCache[] // Cached macros per Edamam policy
  mealPlans        MealPlan[] // User's meal plans
}

model UserProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  dateOfBirth         DateTime
  dailyCalories       Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  allergies           String[]
  carbsGrams          Int
  cuisinePrefs        String[]
  dietaryGoal         String
  dietaryType         String[]
  fatGrams            Int
  heightCm            Float
  onboardingCompleted Boolean        @default(false)
  proteinGrams        Int
  weightKg            Float
  gender              String
  activityLevel       String
  familyMembers       FamilyMember[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String      @id @default(uuid())
  name         String
  dateOfBirth  DateTime
  relationship String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dietaryNeeds String[]
  heightCm     Float?
  profileId    String
  weightKg     Float?
  gender       String
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  prepTime     Int? // minutes
  cookTime     Int? // minutes
  servings     Int      @default(1)
  difficulty   String? // easy, medium, hard
  ingredients  Json? // Raw ingredients from form { name, amount, unit }
  instructions String[] // Array of step instructions

  // Nutritional information per serving
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  // Metadata
  source    String? // url, manual, imported
  sourceUrl String?
  tags      String[]
  isPublic  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories        RecipeCategory[]
  favoritedBy       UserFavorite[]
  recipeIngredients RecipeIngredient[] // Parsed ingredients with USDA FDC matches
  edamamMacroCache  EdamamUserMacroCache[] // Per-user cached macros from Edamam
  mealPlanMeals     MealPlanMeal[] // Usage in meal plans
}

model RecipeCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  iconName    String? // for UI display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]
}

model UserFavorite {
  id       String @id @default(uuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

// ============================================================================
// USDA FoodData Central Integration Models
// ============================================================================

model FdcCache {
  fdcId          Int      @id
  description    String
  dataType       String
  brandOwner     String?  @db.VarChar(255)
  foodPortions   Json? // from FDC foodPortions array
  foodNutrients  Json? // from FDC foodNutrients (abridged or full)
  labelNutrients Json? // Branded foods per serving info if present
  lastFetchedAt  DateTime @default(now())

  @@index([dataType])
  @@index([description])
}

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  originalText String // Original ingredient line as entered
  nameNorm     String // Normalized ingredient name for matching
  qty          Float // Parsed quantity
  unit         String // Normalized unit (g, cup, tbsp, etc.)
  fdcId        Int? // Matched USDA FDC food ID
  gramWeight   Float? // Resolved grams for qty * unit
  confidence   Float? // Matching confidence (0.0-1.0)
  debugJson    Json? // Debug info for troubleshooting

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([nameNorm])
}

// ============================================================================
// Edamam Nutrition Analysis Integration Models
// ============================================================================

model EdamamRecipeCache {
  id            String   @id @default(uuid())
  fingerprint   String   @unique // Deterministic hash of recipe content (title + ingredients)
  etag          String // ETag from Edamam API for cost control
  recipeData    Json // Original recipe data sent to Edamam
  fullResponse  Json // Complete Edamam API response (all nutrients, labels, etc.)
  lastAnalyzed  DateTime @default(now())
  analysisCount Int      @default(1) // Track how many times this recipe was analyzed

  @@index([fingerprint])
  @@index([lastAnalyzed])
}

model EdamamUserMacroCache {
  id       String @id @default(uuid())
  userId   String
  recipeId String // Link to recipe for context

  // Only 4 macros allowed for persistent storage per Edamam policy
  calories Float // kcal
  protein  Float // grams
  fat      Float // grams
  netCarbs Float // grams (total carbs - fiber)

  servings  Int      @default(1) // Number of servings for the recipe
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

// ============================================================================
// Meal Planning System
// ============================================================================

model MealPlan {
  id     String @id @default(uuid())
  userId String
  name   String

  // Date range for the meal plan
  startDate DateTime
  endDate   DateTime

  // Meal slot configuration (which meals to show per day)
  mealSlots String[] @default(["breakfast", "lunch", "dinner"])

  // Macro targets (daily averages)
  targetCalories Float? // kcal per day
  targetProtein  Float? // grams per day
  targetCarbs    Float? // grams per day
  targetFat      Float? // grams per day

  // Plan status
  isActive Boolean @default(false) // Only one active plan per user
  isPublic Boolean @default(false) // Allow public sharing

  // Sharing
  shareToken String? @unique // For public share links

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days MealPlanDay[]

  @@index([userId])
  @@index([shareToken])
  @@index([userId, isActive])
}

model MealPlanDay {
  id         String   @id @default(uuid())
  mealPlanId String
  date       DateTime // Specific date for this day
  dayOfWeek  Int // 0=Sunday, 1=Monday, ..., 6=Saturday

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealPlan MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meals    MealPlanMeal[]

  @@unique([mealPlanId, date])
  @@index([mealPlanId])
  @@index([date])
}

model MealPlanMeal {
  id            String @id @default(uuid())
  mealPlanDayId String
  recipeId      String
  mealType      String // breakfast, lunch, dinner, snack
  servings      Int    @default(1) // Can override recipe default servings
  sortOrder     Int    @default(0) // For ordering meals within a slot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealPlanDay MealPlanDay @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  recipe      Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([mealPlanDayId])
  @@index([recipeId])
  @@index([mealPlanDayId, mealType])
}
