generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  profile   UserProfile?
  recipes   Recipe[]
  favorites UserFavorite[]
}

model UserProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  dateOfBirth         DateTime
  dailyCalories       Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  allergies           String[]
  carbsGrams          Int
  cuisinePrefs        String[]
  dietaryGoal         String
  dietaryType         String[]
  fatGrams            Int
  heightCm            Float
  onboardingCompleted Boolean        @default(false)
  proteinGrams        Int
  weightKg            Float
  gender              String
  activityLevel       String
  familyMembers       FamilyMember[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String      @id @default(uuid())
  name         String
  dateOfBirth  DateTime
  relationship String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dietaryNeeds String[]
  heightCm     Float?
  profileId    String
  weightKg     Float?
  gender       String
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  prepTime     Int? // minutes
  cookTime     Int? // minutes
  servings     Int      @default(1)
  difficulty   String? // easy, medium, hard
  ingredients  Json // Array of { name, amount, unit }
  instructions String[] // Array of step instructions

  // Nutritional information per serving
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
  sugar    Float?
  sodium   Float?

  // Metadata
  source    String? // url, manual, imported
  sourceUrl String?
  tags      String[]
  isPublic  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  RecipeCategory[]
  favoritedBy UserFavorite[]
}

model RecipeCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  iconName    String? // for UI display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]
}

model UserFavorite {
  id       String @id @default(uuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}
