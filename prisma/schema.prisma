generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String? // Public author name; falls back to email prefix at render
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Stripe subscription
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("starter") // "starter" | "pro"
  subscriptionStatus   String? // trialing | active | past_due | canceled | incomplete | incomplete_expired | unpaid
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  hasUsedTrial         Boolean   @default(false) // true once the user has started a Stripe trial — gates one trial per account

  profile             UserProfile?
  recipes             Recipe[]
  favorites           UserFavorite[]
  edamamMacroCache    EdamamUserMacroCache[] // Cached macros per Edamam policy
  mealPlanTemplates   MealPlanTemplate[] // User's meal plan templates
  mealPlanSchedules   MealPlanSchedule[] // User's scheduled meal plans
  shoppingPreferences ShoppingPreferences? // User's shopping automation preferences
  storeCredentials    StoreCredential[] // Per-store encrypted credentials for auto-login
  conversations       Conversation[] // In-app AI chat conversations
  multimodalImports   MultimodalImportEvent[] // DIE-41 image-based recipe imports
}

model UserProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  dateOfBirth         DateTime
  dailyCalories       Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  allergies           String[]
  carbsGrams          Int
  cuisinePrefs        String[]
  dietaryGoal         String
  dietaryType         String[]
  fatGrams            Int
  heightCm            Float
  onboardingCompleted Boolean        @default(false)
  proteinGrams        Int
  weightKg            Float
  gender              String
  activityLevel       String
  familyMembers       FamilyMember[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String      @id @default(uuid())
  name         String
  dateOfBirth  DateTime
  relationship String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dietaryNeeds String[]
  heightCm     Float?
  profileId    String
  weightKg     Float?
  gender       String
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  prepTime     Int? // minutes
  cookTime     Int? // minutes
  servings     Int      @default(1)
  difficulty   String? // easy, medium, hard
  ingredients  Json? // Raw ingredients from form { name, amount, unit }
  instructions String[] // Array of step instructions

  // Nutritional information per serving
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  // Extended nutrition per serving (optional micronutrients)
  sugar        Float?
  sodium       Float?
  cholesterol  Float?
  saturatedFat Float?
  transFat     Float?
  vitaminA     Float?
  vitaminC     Float?
  vitaminD     Float?
  vitaminE     Float?
  vitaminK     Float?
  vitaminB12   Float?
  folate       Float?
  iron         Float?
  calcium      Float?
  magnesium    Float?
  potassium    Float?
  zinc         Float?

  // Metadata
  source    String? // url, manual, imported
  sourceUrl String?
  tags      String[]
  isPublic  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories        RecipeCategory[]
  favoritedBy       UserFavorite[]
  recipeIngredients RecipeIngredient[] // Parsed ingredients with USDA FDC matches
  edamamMacroCache  EdamamUserMacroCache[] // Per-user cached macros from Edamam
  mealPlanMeals     MealPlanMeal[] // Usage in meal plans
  multimodalImports MultimodalImportEvent[] // DIE-41 image-based imports that produced this recipe

  @@index([userId])
  @@index([isPublic, createdAt])
}

model RecipeCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  iconName    String? // for UI display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]
}

model UserFavorite {
  id       String @id @default(uuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

// ============================================================================
// USDA FoodData Central Integration Models
// ============================================================================

model FdcCache {
  fdcId           Int      @id
  description     String
  dataType        String
  brandOwner      String?  @db.VarChar(255)
  foodPortions    Json? // from FDC foodPortions array
  foodNutrients   Json? // from FDC foodNutrients (abridged or full)
  labelNutrients  Json? // Branded foods per serving info if present
  lastFetchedAt   DateTime @default(now())
  // Which nutrient set this cached row holds: "core" (5 macros, legacy) or
  // "extended" (full registry). Added by 20260610000000; modeled here to keep
  // schema↔migrations↔DB consistent (the column exists on the shared DB).
  nutrientProfile String   @default("core")

  @@index([dataType])
  @@index([description])
}

// Caches the USDA FDC ingredient *search* step (food detail is cached above in
// FdcCache). Keyed by the normalized query so repeated analyses of recipes that
// share ingredients reuse cached results instead of re-hitting USDA search.
model FdcSearchCache {
  query         String   @id // normalized query (lowercased, whitespace-collapsed)
  results       Json // cached FdcSearchFood[] from the USDA search endpoint
  lastFetchedAt DateTime @default(now())

  @@index([lastFetchedAt])
}

model IngredientNameCache {
  key           String   @id // normalized raw name (lowercased, whitespace-collapsed)
  canonical     String? // English canonical name, or null = not a food
  lastFetchedAt DateTime @default(now())

  @@index([lastFetchedAt])
}

// LLM per-100g macro estimates for foods USDA does not carry (ADR 0003 coverage
// chain). Keyed by the normalized CANONICAL name, so one estimate serves every
// raw spelling that canonicalizes to it. Only successful (non-null) estimates
// are cached; a transient/declined estimate is left to retry.
model IngredientEstimateCache {
  name          String   @id // normalized canonical English name
  kcal          Float
  protein       Float
  fat           Float
  carbs         Float
  fiber         Float
  lastFetchedAt DateTime @default(now())

  @@index([lastFetchedAt])
}

// Cached LLM-primary recipe analysis (ADR 0003, Stage 2 + the cacheable USDA
// asset). Keyed by the recipe fingerprint (title + ingredient lines). USDA
// FoodData Central is public domain, so — unlike Edamam — we may persist the
// full 22-nutrient per-serving Profile. Only successful analyses are cached;
// gated end-to-end by INGREDIENT_LLM_FALLBACK at the repo layer.
model RecipeAnalysisCache {
  fingerprint    String   @id // generateRecipeFingerprint(title + ingredients)
  servings       Int
  profileJson    Json // cached 22-nutrient per-serving Profile
  stage2Json     Json // per-ingredient cookedState/retention + diet/health labels
  coverageJson   Json // CoverageSummary at analysis time
  lastAnalyzedAt DateTime @default(now())

  @@index([lastAnalyzedAt])
}

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  originalText String // Original ingredient line as entered
  nameNorm     String // Normalized ingredient name for matching
  qty          Float // Parsed quantity
  unit         String // Normalized unit (g, cup, tbsp, etc.)
  fdcId        Int? // Matched USDA FDC food ID
  gramWeight   Float? // Resolved grams for qty * unit
  confidence   Float? // Matching confidence (0.0-1.0)
  debugJson    Json? // Debug info for troubleshooting

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([nameNorm])
}

// ============================================================================
// Edamam Nutrition Analysis Integration Models
// ============================================================================

model EdamamRecipeCache {
  id            String   @id @default(uuid())
  fingerprint   String   @unique // Deterministic hash of recipe content (title + ingredients)
  etag          String // ETag from Edamam API for cost control
  recipeData    Json // Original recipe data sent to Edamam
  fullResponse  Json // Complete Edamam API response (all nutrients, labels, etc.)
  lastAnalyzed  DateTime @default(now())
  analysisCount Int      @default(1) // Track how many times this recipe was analyzed

  @@index([fingerprint])
  @@index([lastAnalyzed])
}

model EdamamUserMacroCache {
  id       String @id @default(uuid())
  userId   String
  recipeId String // Link to recipe for context

  // Only 4 macros allowed for persistent storage per Edamam policy
  calories Float // kcal
  protein  Float // grams
  fat      Float // grams
  netCarbs Float // grams (total carbs - fiber)

  servings  Int      @default(1) // Number of servings for the recipe
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

// ============================================================================
// Meal Planning System (Template-Based Architecture)
// ============================================================================

// MealPlanTemplate: Reusable meal plan templates without fixed dates
model MealPlanTemplate {
  id       String @id @default(uuid())
  userId   String
  name     String
  duration Int // Duration in days (e.g., 7 for a week)

  // Meal slot configuration (which meals to show per day)
  mealSlots String[] @default(["breakfast", "lunch", "dinner"])

  // Macro targets (daily averages)
  targetCalories Float? // kcal per day
  targetProtein  Float? // grams per day
  targetCarbs    Float? // grams per day
  targetFat      Float? // grams per day

  // Sharing
  isPublic   Boolean @default(false) // Allow public sharing
  shareToken String? @unique // For public share links

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      MealPlanDay[] // Template days (day 1, day 2, etc.)
  schedules MealPlanSchedule[] // Where this template is scheduled

  @@index([userId])
  @@index([shareToken])
  @@index([isPublic, createdAt])
}

// MealPlanSchedule: Tracks when/where templates are used on the calendar
model MealPlanSchedule {
  id         String   @id @default(uuid())
  templateId String
  userId     String
  startDate  DateTime // When this schedule starts
  status     String   @default("active") // active, completed, cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateId])
  @@index([startDate])
  @@index([userId, startDate]) // For overlap detection
}

// MealPlanDay: Template days with relative day numbers
model MealPlanDay {
  id         String @id @default(uuid())
  templateId String
  dayNumber  Int // Relative day number (1, 2, 3, ... duration)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  meals    MealPlanMeal[]

  @@unique([templateId, dayNumber])
  @@index([templateId])
}

// MealPlanMeal: Individual recipe assignments (unchanged structure)
model MealPlanMeal {
  id               String  @id @default(uuid())
  mealPlanDayId    String
  recipeId         String? // nullable: AI-generated slots may fail before a recipe exists
  mealType         String // breakfast, lunch, dinner, snack
  servings         Int     @default(1) // Can override recipe default servings
  sortOrder        Int     @default(0) // For ordering meals within a slot
  generationFailed Boolean @default(false)
  generationError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealPlanDay MealPlanDay @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  recipe      Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([mealPlanDayId])
  @@index([recipeId])
  @@index([mealPlanDayId, mealType])
}

// ============================================================================
// Shopping Automation Preferences
// ============================================================================

// ShoppingPreferences: User's preferred store and shopping automation settings
model ShoppingPreferences {
  id                 String  @id @default(uuid())
  userId             String  @unique
  selectedStore      String? // "auchan" | "frisco" | "carrefour"
  deliveryPreference String  @default("delivery") // "delivery" | "pickup"
  zipCode            String?
  preferOrganic      Boolean @default(false)
  preferStoreBrand   Boolean @default(false)
  allowSubstitutions Boolean @default(true)
  maxPricePerItem    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// StoreCredential: Per-store encrypted credentials for auto-login during shopping automation
model StoreCredential {
  id                String @id @default(uuid())
  userId            String
  store             String // "auchan" | "frisco" | "carrefour"
  email             String
  encryptedPassword String // AES-256-GCM encrypted
  iv                String // Initialization vector for decryption
  authTag           String // Authentication tag for GCM verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, store]) // One credential per store per user
  @@index([userId])
}

// ============================================================================
// AI Chat Agent — Conversation Persistence (DIE-39)
// ============================================================================
// Decision #112 (locked 2026-05-15): ONE active conversation per user. The
// "Limpiar" action sets archivedAt; the next user turn creates a fresh
// conversation. Partial unique index added in the migration enforces this at
// the DB level: UNIQUE (userId) WHERE archivedAt IS NULL.

model Conversation {
  id         String    @id @default(uuid())
  userId     String
  title      String?   // auto-set from first user message (60 chars); null until first turn
  archivedAt DateTime? // null = active; non-null = archived "Limpiar"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  multimodalImports MultimodalImportEvent[]

  @@index([userId, archivedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // "user" | "assistant" | "tool" | "metadata"
  content        Json // ConversationTurnItem: { kind: "text"|"tool-call"|"tool-result"|"metadata", ... }
  createdAt      DateTime @default(now())

  // DIE-38 cost cap (shadow-mode). Filled on the assistant message that closes
  // an LLM step, derived from finish.usage. Sum-over-month gives per-user cost.
  inputTokens  Int?
  outputTokens Int?

  // DIE-41 attachments. Array of { kind: "image", mediaRef, eventId }. Null for
  // text-only messages. Populated on user messages that carry an upload.
  attachments Json?

  conversation      Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  multimodalImports MultimodalImportEvent[]

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

// ============================================================================
// AI Chat Agent — Multimodal Imports (DIE-41)
// ============================================================================
// Tracks every image upload + extraction attempt by the in-app chat agent.
// Two purposes: (1) per-user daily cap (count rows for userId where createdAt
// >= startOfDay), (2) Supabase Storage retention cleanup (cron deletes blob
// 7d post-success, 30d post-failure, then sets deletedAt).
//
// Storage path scheme: {userId}/{eventId}/{filename}. eventId is the row id,
// generated at upload time — eliminates the need for conversationId/messageId
// in the path (those are filled AFTER the message is sent and are nullable).

model MultimodalImportEvent {
  id             String  @id @default(uuid())
  userId         String
  conversationId String? // filled when the message carrying this upload is persisted
  messageId      String? // filled when the message carrying this upload is persisted
  recipeId       String? // filled on successful extraction + persist

  kind      String // "image" (audio reserved for v1.1)
  mediaPath String // Supabase Storage path: {userId}/{id}/{filename}
  mimeType  String // image/jpeg | image/png | image/webp | image/heic
  sizeBytes Int

  outcome String // "pending" | "success" | "failure"
  reason  String? // failure reason: "no-ingredients" | "low-quality" | "unsupported-format" | "cost-cap-day" | ...

  createdAt   DateTime  @default(now())
  processedAt DateTime? // set when the tool finishes (success or failure)
  deletedAt   DateTime? // set when bucket blob is wiped (cron or user-initiated)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipe       Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt]) // daily cap query
  @@index([outcome, processedAt]) // success cleanup (outcome=success AND processedAt < now - 7d)
  @@index([outcome, createdAt]) // failure cleanup (outcome=failure AND createdAt < now - 30d)
  @@index([deletedAt])
}
