generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  profile   UserProfile?
  recipes   Recipe[]
  favorites UserFavorite[]
}

model UserProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  dateOfBirth         DateTime
  dailyCalories       Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  allergies           String[]
  carbsGrams          Int
  cuisinePrefs        String[]
  dietaryGoal         String
  dietaryType         String[]
  fatGrams            Int
  heightCm            Float
  onboardingCompleted Boolean        @default(false)
  proteinGrams        Int
  weightKg            Float
  gender              String
  activityLevel       String
  familyMembers       FamilyMember[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String      @id @default(uuid())
  name         String
  dateOfBirth  DateTime
  relationship String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dietaryNeeds String[]
  heightCm     Float?
  profileId    String
  weightKg     Float?
  gender       String
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  prepTime     Int? // minutes
  cookTime     Int? // minutes
  servings     Int      @default(1)
  difficulty   String? // easy, medium, hard
  ingredients  Json // Array of { name, amount, unit }
  instructions String[] // Array of step instructions

  // Nutritional information per serving
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
  sugar    Float?
  sodium   Float?

  // Metadata
  source    String? // url, manual, imported
  sourceUrl String?
  tags      String[]
  isPublic  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  RecipeCategory[]
  favoritedBy UserFavorite[]
}

model RecipeCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  iconName    String? // for UI display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]
}

model UserFavorite {
  id       String @id @default(uuid())
  userId   String
  recipeId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

// Ingredient and Nutrition Models for Persistent Caching
model Ingredient {
  id         String  @id @default(uuid())
  name       String  @unique
  commonName String? // Alternative/common name for matching
  category   String? // food category (meat, vegetable, etc.)

  // USDA Data (when available)
  usdaFdcId    Int?    @unique
  usdaDataType String? // "foundation", "sr_legacy", "survey", "branded"

  // Metadata
  searchTerms String[] // Additional terms for fuzzy matching
  confidence  Float    @default(1.0) // Confidence in ingredient identification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  nutrients IngredientNutrient[]

  @@index([name])
  @@index([usdaFdcId])
}

model Nutrient {
  id               String @id @default(uuid())
  name             String @unique
  nutrientCategory String // "Macronutrients", "Vitamins", "Minerals", etc.
  unit             String // "g", "mg", "kcal", etc.

  // USDA nutrient number for mapping
  usdaNutrientId Int? @unique

  // Daily Value information
  dailyValue     Float? // Daily value amount
  dailyValueUnit String? // Unit for daily value

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ingredientNutrients IngredientNutrient[]

  @@index([name])
  @@index([usdaNutrientId])
}

model IngredientNutrient {
  id           String @id @default(uuid())
  ingredientId String
  nutrientId   String

  // Nutritional values (per 100g)
  value Float

  // Metadata
  confidence Float  @default(1.0) // Confidence in this specific nutrient value
  source     String @default("usda") // "usda", "manual", "estimated"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  nutrient   Nutrient   @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, nutrientId])
  @@index([ingredientId])
  @@index([nutrientId])
}

// Cache for processed nutrition calculations
model NutritionCache {
  id       String @id @default(uuid())
  cacheKey String @unique // Hash of ingredients list + servings

  // Cached data
  nutritionData Json // Serialized nutrition calculation result

  // Metadata
  servings   Int
  confidence Float
  sources    Json // Source breakdown (local, usda, cached counts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cacheKey])
}
