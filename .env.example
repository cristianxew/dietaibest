# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dietai
DIRECT_URL=postgresql://user:password@localhost:5432/dietai

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# External APIs (existing)
# ─────────────────────────────────────────────────────────────────────────────
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
FDC_API_KEY=
BROWSER_USE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────────────────────
# Server-side secret key (sk_test_... in test mode, sk_live_... in prod)
STRIPE_SECRET_KEY=sk_test_...

# Publishable key — exposed to the browser (pk_test_... / pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret for /api/webhooks/stripe
# Get it from `stripe listen` in dev, or from the Webhooks page in the Stripe dashboard in prod.
STRIPE_WEBHOOK_SECRET=whsec_...

# Free trial length in days — configured here so it can be changed without touching Stripe.
STRIPE_TRIAL_DAYS=14

SUPADATA_API_KEY=

GEMINI_API_KEY=

GEMINMI_PROJECT_NUMBER=

ANTHROPIC_API_KEY=